{
  "name": "@unifast/vite",
  "version": "0.0.7",
  "description": "Vite plugin for unifast — transform Markdown and MDX files into JS modules",
  "keywords": [
    "markdown",
    "mdx",
    "unifast",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://unifast.dev",
  "bugs": {
    "url": "https://github.com/kenzo-pj/unifast/issues"
  },
  "license": "MIT",
  "author": "Kenzo-Wada",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenzo-pj/unifast",
    "directory": "packages/vite"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint:oxc": "oxlint -c ../../.oxlintrc.json .",
    "lint:oxc:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "typecheck": "tsc --noEmit",
    "fmt:oxc": "oxfmt --write .",
    "fmt:oxc:check": "oxfmt --check .",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "dependencies": {
    "@unifast/core": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@unifast/node": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@unifast/node": "workspace:^",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@unifast/node": {
      "optional": true
    }
  }
}
