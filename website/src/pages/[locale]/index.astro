---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LandingPage } from "../../components/LandingPage";
import { SUPPORTED_LOCALES, DEFAULT_LOCALE, getTranslation, type LocaleCode } from "../../i18n";

const { locale } = Astro.params as { locale: LocaleCode };
const { t } = getTranslation(locale);

const title = t("landing.metaTitle");
const description = t("landing.metaDescription");

export function getStaticPaths() {
  return SUPPORTED_LOCALES
    .filter((l) => l !== DEFAULT_LOCALE)
    .map((loc) => ({ params: { locale: loc } }));
}
---

<BaseLayout title={title} description={description} lang={locale}>
  <LandingPage client:load locale={locale} />
</BaseLayout>
